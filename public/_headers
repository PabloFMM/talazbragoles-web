# Cloudflare Pages: cabeceras (sustituye a vercel.json)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Subidas de la subasta: el nombre lleva el resumen del contenido, así que no caducan
/mmo/wow-forever/asesor/datos/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
