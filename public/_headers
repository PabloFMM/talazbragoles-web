# Cloudflare Pages: cabeceras (sustituye a vercel.json)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Subidas de la subasta: el nombre lleva el resumen del contenido, así que no caducan
/mmo/wow-forever/asesor/datos/*
  Cache-Control: public, max-age=31536000, immutable

# Módulos de Rol en un solo Markdown (CC0), para leer o descargar
/rol/modulos/*.md
  Content-Type: text/markdown; charset=utf-8

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
