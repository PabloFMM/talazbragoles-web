---
/**
 * /ediciones/<slug>/: ficha de una edición. Datos (vacíos = «pendiente»),
 * lo que cuentan las fuentes, actividades, notas de fuente y cronología.
 */
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Estado from "../../components/sistema/Estado.astro";
import Datos from "../../components/sistema/Datos.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import NotaFuente from "../../components/sistema/NotaFuente.astro";
import { getAllTimeline } from "../../lib/collections";
import { partesFecha, tipoActividad } from "../../lib/formato";

export async function getStaticPaths() {
  const editions = await getCollection("editions");
  return editions.map((e) => ({ params: { slug: e.id }, props: { edition: e } }));
}

const { edition } = Astro.props;
const { year, title, status, verified, venue, organizer, description, activities, sourceIds, documentos } = edition.data;

const fuentes = (await getCollection("sources")).filter((s) => sourceIds.includes(s.id));
const cronologia = (await getAllTimeline()).filter((t) => t.data.relatedEditionId === edition.id);

const numeroFuente = (id: string) => fuentes.findIndex((f) => f.id === id) + 1;
// Secciones numeradas: «Documentos» solo existe si la edición tiene alguno.
let n = 2;
const num = () => String(++n).padStart(2, "0");
const nDocumentos = documentos.map(() => num());
const nFuentes = num();
const nCrono = num();

const anoTexto = year === "desconocida" ? "Año pendiente" : String(year);
const datos = [
  { etiqueta: "Año", valor: year === "desconocida" ? undefined : year },
  { etiqueta: "Ciudad", valor: venue?.city },
  { etiqueta: "Lugar", valor: venue?.name },
  { etiqueta: "Dirección", valor: venue?.address },
  { etiqueta: "Organización", valor: organizer },
];
---

<Layout
  title={title}
  description={description ?? `Ficha de la edición de las Jornadas Talazbrágoles (${anoTexto.toLowerCase()}): datos, fuentes y lo que falta.`}
>
  <div class="tz-pagina">
    <Encabezado
      migas={[{ texto: "Ediciones", href: "/ediciones" }, { texto: anoTexto }]}
      numero={year === "desconocida" ? "—" : String(year)}
      seccion="Edición"
      titulo={title}
    >
      <p class="tz-recuento"><Estado estado={status} />{!verified && <> · sin verificar</>}</p>
    </Encabezado>

    <section class="tz-seccion" aria-labelledby="s-datos">
      <Titulo id="s-datos" numero="01">Datos</Titulo>
      <div class="tz-con-margen">
        <div>
          <Datos datos={datos} />
          {description && (
            <div class="tz-prosa" style="margin-top:var(--e-6)">
              <h3 class="tz-subtitulo" style="margin-top:0">Lo que cuentan las fuentes</h3>
              <p>{description}</p>
            </div>
          )}
        </div>
        <aside class="tz-margen">
          <p class="tz-rotulo">Cómo leer la ficha</p>
          <p>Cada dato sale de las fuentes de abajo. Si ninguna lo dice, aparece «pendiente».</p>
        </aside>
      </div>
    </section>

    <section class="tz-seccion" aria-labelledby="s-actividades">
      <Titulo id="s-actividades" numero="02">Actividades</Titulo>
      {activities.length > 0 ? (
        <ol class="tz-lista-numerada tz-medida">
          {activities.map((a) => (
            <li>
              <div>
                <p class="tz-item-titulo">{a.name}</p>
                <p class="tz-ref tz-item-meta">
                  {[tipoActividad[a.type], a.system && `Sistema: ${a.system}`, a.gm && `Dirige: ${a.gm}`].filter(Boolean).join(" · ")}
                </p>
                {a.description && <p class="tz-item-texto">{a.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="tz-medida">
          <Pendiente
            mensaje={description
              ? "La lista de partidas, torneos y charlas de esta edición está sin registrar. Lo poco que se sabe está en «Lo que cuentan las fuentes»."
              : "No hay ninguna actividad registrada de esta edición."}
            pide="Ayudaría el programa de la edición o una lista de partidas."
          />
        </div>
      )}
    </section>

    {documentos.map((d, i) => (
      <section class="tz-seccion" id={d.id} aria-labelledby={`s-doc-${d.id}`}>
        <Titulo id={`s-doc-${d.id}`} numero={nDocumentos[i]}>{d.titulo}</Titulo>
        <div class="tz-con-margen">
          <div>
            {d.descripcion && <p class="tz-prosa tz-medida" style="margin-top:0">{d.descripcion}</p>}
          </div>
          <aside class="tz-margen">
            <p class="tz-rotulo">Fuente</p>
            <p>{numeroFuente(d.sourceId) > 0
              ? <a class="tz-enlace" href={`#${d.sourceId}`}>Nota {String(numeroFuente(d.sourceId)).padStart(2, "0")} de «Fuentes»</a>
              : <Pendiente />}</p>
          </aside>
        </div>
        <ol class="tz-documento">
          {d.caras.map((c, j) => (
            <li class="tz-documento-cara">
              <a class="tz-documento-imagen" href={c.imagen} aria-label={`${c.titulo}: ver la imagen sola, a tamaño completo`}>
                <img src={c.imagen} width={c.ancho} height={c.alto} alt={c.alt} loading={j === 0 ? "eager" : "lazy"} decoding="async" />
              </a>
              <div class="tz-documento-texto">
                <h3 class="tz-subtitulo">{c.titulo}</h3>
                {c.texto.length > 0 ? (
                  <blockquote class="tz-documento-literal" lang="es">
                    {c.texto.map((t) => <p>{t}</p>)}
                  </blockquote>
                ) : <Pendiente mensaje="Texto de esta cara sin copiar." />}
                {c.nota && <p class="tz-documento-nota">{c.nota}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="tz-seccion" aria-labelledby="s-fuentes">
      <Titulo id="s-fuentes" numero={nFuentes}>Fuentes</Titulo>
      {fuentes.length > 0 ? (
        <ol class="tz-fuentes tz-medida">
          {fuentes.map((s, i) => <NotaFuente fuente={s} n={i + 1} ancla />)}
        </ol>
      ) : (
        <div class="tz-medida"><Pendiente mensaje="Esta edición no tiene ninguna fuente enlazada." /></div>
      )}
    </section>

    {cronologia.length > 0 && (
      <section class="tz-seccion" aria-labelledby="s-crono">
        <Titulo id="s-crono" numero={nCrono}>En la cronología</Titulo>
        <ul class="tz-lista-numerada tz-medida">
          {cronologia.map((t) => {
            const f = partesFecha(t.data.date, t.data.precision);
            return (
              <li><span>{[f.resto, f.ano].filter(Boolean).join(" de ")}: <a class="tz-enlace" href={`/cronologia#${t.id}`}>{t.data.title}</a></span></li>
            );
          })}
        </ul>
      </section>
    )}

    <div class="tz-acciones" style="margin-bottom:var(--aire)">
      <a class="tz-boton" href="/ediciones"><span aria-hidden="true">‹</span> Todas las ediciones</a>
    </div>
  </div>
</Layout>
