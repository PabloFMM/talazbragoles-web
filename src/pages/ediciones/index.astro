---
/**
 * /ediciones/: portada de la sección (Ediciones 2/2, decisión P4). Todos los años
 * de la edición más reciente a la más antigua, «Sin fecha» al final; cada uno con
 * su portada en miniatura (cara 1 del folleto o cartel) o un hueco tipográfico
 * con el año, su estado documental y cuántos documentos tiene. No redirige.
 */
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Estado from "../../components/sistema/Estado.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import { getAllEditions, hrefEdicion } from "../../lib/collections";
import { plural, type EstadoDocumental } from "../../lib/formato";
import { numeroSeccion } from "../../lib/nav";

const ediciones = await getAllEditions();
const cuenta = (s: EstadoDocumental) => ediciones.filter((e) => e.data.status === s).length;
const recuento = [
  plural(cuenta("documentada"), "documentada", "documentadas"),
  plural(cuenta("parcial"), "parcial", "parciales"),
  plural(cuenta("pendiente"), "pendiente", "pendientes"),
].join(", ");
---

<Layout
  title="Ediciones"
  description="Ediciones de las Jornadas Talazbrágoles año a año, de la más reciente a la más antigua: portada, estado documental, documentos y fuentes de cada una."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/ediciones")}
      seccion="Archivo"
      titulo="Ediciones"
      entradilla="Año a año, de la más reciente a la más antigua. Solo se afirma lo que dice alguna fuente; lo demás queda pendiente."
    >
      <p class="tz-recuento">{plural(ediciones.length, "edición registrada", "ediciones registradas")}: {recuento}.</p>
    </Encabezado>

    <section class="tz-seccion" aria-labelledby="s-por-ano">
      <Titulo id="s-por-ano" numero="01">Por año</Titulo>
      {ediciones.length > 0 ? (
        <ol class="tz-ediciones">
          {ediciones.map((e) => {
            const { year, numero, title, status, portada, documentos, anioEstado } = e.data;
            const sinFecha = year === "desconocida";
            const anoTexto = sinFecha ? "Sin fecha" : String(year);
            return (
              <li class="tz-ediciones-item">
                <a class="tz-ediciones-enlace" href={hrefEdicion(e.id)}>
                  {portada ? (
                    <span class="tz-documento-imagen tz-ediciones-imagen">
                      <img src={portada.imagen} width={portada.ancho} height={portada.alto} alt={portada.alt} loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span class="tz-edicion-hueco tz-ediciones-hueco" aria-hidden="true">
                      <span class="tz-edicion-hueco-anio">{anoTexto}</span>
                    </span>
                  )}
                  <span class="tz-ediciones-anio">{anoTexto}{numero && <> · {numero.romano} edición</>}</span>
                  <span class="tz-ediciones-titulo">{title}</span>
                </a>
                <ul class="tz-registro-meta">
                  <li><Estado estado={status} /></li>
                  {anioEstado && anioEstado.estado !== "confirmado" && <li>{anioEstado.estado === "deducido" ? "Año deducido" : "Año atribuido"}</li>}
                  {numero?.deducido && <li>Número deducido</li>}
                  <li>{documentos.length ? plural(documentos.length, "documento", "documentos") : <>Documentos: <Pendiente /></>}</li>
                </ul>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="tz-medida"><Pendiente mensaje="Todavía no hay ninguna edición registrada." /></div>
      )}
    </section>

    <section class="tz-seccion" aria-labelledby="s-falta">
      <Titulo id="s-falta" numero="02">Lo que falta</Titulo>
      <div class="tz-con-margen">
        <ol class="tz-lista-numerada">
          <li><span>Cuántas ediciones hubo y en qué años. Los documentos de cada año confirman la I en 1992, la II en 1993, la IV en 1995, la V en 1996, la VI en 1997 y la VII en 1998; la III de 1994 se cuenta por la serie (su pin confirma el año, no el número). Los pines confirman que hubo jornadas en 2002 y 2003 (el de 1999 no lleva año), pero no qué número tuvieron, y no sabemos si las hubo en 2000 y 2001.</span></li>
          <li><span>Organización de cada edición: el equipo cambiaba cada año.</span></li>
          <li><span>Lugar exacto de cada edición (edificio o local).</span></li>
          <li><span>Programas, carteles, recortes de prensa y fotos.</span></li>
        </ol>
        <aside class="tz-margen">
          <p class="tz-rotulo">Estado documental</p>
          <p>Documentada: fecha, sede y organización con fuente. Parcial: algún dato con fuente. Pendiente: consta que existió, sin datos verificados.</p>
        </aside>
      </div>
    </section>
  </div>
</Layout>
