---
/** /ediciones/: todas las ediciones por año, con recuento por estado y lo que falta. */
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import RegistroEdiciones from "../../components/archivo/RegistroEdiciones.astro";
import { getAllEditions } from "../../lib/collections";
import { plural, type EstadoDocumental } from "../../lib/formato";
import { numeroSeccion } from "../../lib/nav";

const ediciones = await getAllEditions();
const cuenta = (s: EstadoDocumental) => ediciones.filter((e) => e.data.status === s).length;
const recuento = [
  plural(cuenta("documentada"), "documentada", "documentadas"),
  plural(cuenta("parcial"), "parcial", "parciales"),
  plural(cuenta("pendiente"), "pendiente", "pendientes"),
].join(", ");
---

<Layout
  title="Ediciones"
  description="Ediciones de las Jornadas Talazbrágoles por año: estado documental, sede y fuentes de cada una."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/ediciones")}
      seccion="Archivo"
      titulo="Ediciones"
      entradilla="Cada edición de la que hay noticia, por año. Solo se afirma lo que dice alguna fuente; lo demás queda pendiente."
    >
      <p class="tz-recuento">{plural(ediciones.length, "edición registrada", "ediciones registradas")}: {recuento}.</p>
    </Encabezado>

    <section class="tz-seccion" aria-labelledby="s-por-ano">
      <Titulo id="s-por-ano" numero="01">Por año</Titulo>
      {ediciones.length > 0 ? (
        <RegistroEdiciones ediciones={ediciones} conTexto />
      ) : (
        <div class="tz-medida"><Pendiente mensaje="Todavía no hay ninguna edición registrada." /></div>
      )}
    </section>

    <section class="tz-seccion" aria-labelledby="s-falta">
      <Titulo id="s-falta" numero="02">Lo que falta</Titulo>
      <div class="tz-con-margen">
        <ol class="tz-lista-numerada">
          <li><span>Cuántas ediciones hubo y en qué años. La crónica de La Runa habla de una 5ª edición: de la 1ª a la 4ª no hay ningún dato.</span></li>
          <li><span>Organización de cada edición.</span></li>
          <li><span>Lugar exacto de cada edición (edificio o local).</span></li>
          <li><span>Programas, carteles y listas de partidas.</span></li>
        </ol>
        <aside class="tz-margen">
          <p class="tz-rotulo">Estado documental</p>
          <p>Documentada: fecha, sede y organización con fuente. Parcial: algún dato con fuente. Pendiente: consta que existió, sin datos verificados.</p>
        </aside>
      </div>
    </section>
  </div>
</Layout>
