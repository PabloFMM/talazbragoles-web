---
/** /cronologia/: entradas fechadas de la colección «timeline», de la más antigua a la más reciente. */
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import { getAllTimeline } from "../../lib/collections";
import { anclaFuente, categoriaCronologia, partesFecha } from "../../lib/formato";
import { numeroSeccion } from "../../lib/nav";

const entradas = await getAllTimeline();
const fuentes = await getCollection("sources");
const ediciones = await getCollection("editions");
const tituloFuente = (id: string) => fuentes.find((f) => f.id === id)?.data.title;
const edicion = (id?: string) => (id ? ediciones.find((e) => e.id === id) : undefined);
---

<Layout
  title="Cronología"
  description="Cronología de las Jornadas Talazbrágoles: cada entrada fechada con su fuente."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/cronologia")}
      seccion="Archivo"
      titulo="Cronología"
      entradilla="Lo que se puede fechar, en orden. Algunas entradas fechan cuándo se publicó un testimonio, no cuándo ocurrió lo que cuenta."
    />

    <section class="tz-seccion" aria-labelledby="s-entradas">
      <Titulo id="s-entradas" numero="01">Entradas</Titulo>
      {entradas.length === 0 ? (
        <div class="tz-medida"><Pendiente mensaje="Todavía no hay ninguna entrada fechada." /></div>
      ) : (
        <ol class="tz-crono">
          {entradas.map((t) => {
            const f = partesFecha(t.data.date, t.data.precision);
            const ed = edicion(t.data.relatedEditionId);
            return (
              <li class="tz-crono-entrada" id={t.id}>
                <p class="tz-crono-fecha">
                  <span class="tz-crono-ano">{f.ano}</span>
                  {f.resto && <span class="tz-crono-dia">{f.resto}</span>}
                </p>
                <div class="tz-crono-cuerpo">
                  <ul class="tz-registro-meta">
                    <li>{categoriaCronologia[t.data.category]}</li>
                    <li>{t.data.verified ? "Verificada" : "Sin verificar"}</li>
                  </ul>
                  <h3 class="tz-crono-titulo">{t.data.title}</h3>
                  {t.data.description && <p>{t.data.description}</p>}
                  <p class="tz-ref">
                    {t.data.sourceIds.length > 0 ? (
                      <>Fuente: {t.data.sourceIds.map((id, i) => (
                        <>{i > 0 && "; "}<a href={anclaFuente(id)}>{tituloFuente(id) ?? id}</a></>
                      ))}.</>
                    ) : (
                      <>Fuente: <Pendiente />.</>
                    )}
                    {ed && <> Edición: <a href={`/ediciones/${ed.id}`}>{ed.data.title}</a>.</>}
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </section>

    <section class="tz-seccion" aria-labelledby="s-huecos">
      <Titulo id="s-huecos" numero="02">Huecos</Titulo>
      <div class="tz-medida">
        <Pendiente
          etiqueta="Sin fecha todavía"
          mensaje="El año de la primera edición, el de la última y las fechas de todas las ediciones salvo la 5ª."
          pide="Ayudarían programas, carteles o recortes con fecha."
        />
      </div>
    </section>
  </div>
</Layout>
