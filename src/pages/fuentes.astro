---
/**
 * /fuentes/: corazón documental. Cada fuente con qué dice y con qué reservas.
 * Primero las que nombran las Talazbrágoles; después, las de contexto.
 * Cada nota lleva id = id de la fuente (enlaces /fuentes#<id> desde otras páginas).
 */
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/sistema/Encabezado.astro";
import Titulo from "../components/sistema/Titulo.astro";
import NotaFuente from "../components/sistema/NotaFuente.astro";
import Pendiente from "../components/sistema/Pendiente.astro";
import { getAllSources } from "../lib/collections";
import { dosCifras, plural } from "../lib/formato";
import { numeroSeccion } from "../lib/nav";

const fuentes = await getAllSources();
const nombran = fuentes.filter((s) => s.data.tags.includes("menciona Talazbrágoles"));
const contexto = fuentes.filter((s) => !s.data.tags.includes("menciona Talazbrágoles"));
const grupos = [
  { id: "s-nombran", titulo: "Nombran las Talazbrágoles", lista: nombran },
  { id: "s-contexto", titulo: "Contexto", lista: contexto, nota: "No nombran las Jornadas: sirven para situar la época y el lugar." },
];

const buscamos = [
  "Programas o folletos de cualquier edición, con fecha, sede y organización.",
  "Carteles.",
  "Los números 1 y 2 del periódico La Runa (abril y mayo de 1996), o sus escaneos.",
  "Recortes de prensa local que nombren las Talazbrágoles.",
  "Fotos con fecha o con contexto que se pueda comprobar.",
  "Vídeos y publicaciones con una dirección web estable.",
];
---

<Layout
  title="Fuentes"
  description="Fuentes del archivo de las Jornadas Talazbrágoles: qué dice cada una, con qué reservas y qué falta."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/fuentes")}
      seccion="Archivo"
      titulo="Fuentes"
      entradilla="Todo lo que afirma este archivo sale de aquí. Cada fuente dice qué afirma y con qué reservas; si un enlace se cae, se indica."
    >
      <p class="tz-recuento">{plural(fuentes.length, "fuente", "fuentes")}: {nombran.length} nombran las Talazbrágoles y {contexto.length} dan contexto.</p>
    </Encabezado>

    {grupos.map((g, gi) => (
      <section class="tz-seccion" aria-labelledby={g.id}>
        <Titulo id={g.id} numero={dosCifras(gi + 1)}>{g.titulo}</Titulo>
        {g.nota && <p class="tz-medida" style="margin:0 0 var(--e-5)">{g.nota}</p>}
        {g.lista.length > 0 ? (
          <ol class="tz-fuentes tz-medida">
            {g.lista.map((s, i) => <NotaFuente fuente={s} n={i + 1} ancla />)}
          </ol>
        ) : (
          <div class="tz-medida"><Pendiente mensaje="Todavía no hay ninguna fuente en este grupo." /></div>
        )}
      </section>
    ))}

    <section class="tz-seccion" aria-labelledby="s-buscamos">
      <Titulo id="s-buscamos" numero="03">Qué buscamos</Titulo>
      <div class="tz-con-margen">
        <ol class="tz-lista-numerada">
          {buscamos.map((b) => <li><span>{b}</span></li>)}
        </ol>
        <aside class="tz-margen">
          <p class="tz-rotulo">Cómo enviarlo</p>
          <p>Canal para enviar material: <Pendiente />.</p>
        </aside>
      </div>
    </section>
  </div>
</Layout>
