---
/**
 * /rol/: portada de la sección Rol (fase 1, 2026-11-23). Lo que jugamos ahora:
 * dos puertas grandes, «Ludoteca» (juegos, sistemas, licencias, autoría, editoriales)
 * y «Crónicas» (módulos, campañas y mesas), con imagen (2026-11-25); después, las portadas de lo jugado. Lo jugado en las
 * Jornadas históricas está en /sistemas/ (Archivo).
 * Accesos a Juegos (con filtros), Sistemas, Licencias, Autoría y Editoriales.
 */
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Estado from "../../components/sistema/Estado.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import PortadaJuego from "../../components/sistema/PortadaJuego.astro";
import CreditoPortada from "../../components/sistema/CreditoPortada.astro";
import { getAllJuegos, getSistemasRol, getAllLicencias, getAllAutoria, getAllEditoriales, resuelveJuego, getAllModulos, getAllCampanas, getAllMesas } from "../../lib/collections";
import { hrefCampana, hrefMesa, hrefModulo } from "../../lib/rol-rutas";
import { estadoJuego } from "../../lib/formato";
import { numeroSeccion } from "../../lib/nav";
import { Picture } from "astro:assets";
import imagenCronicas from "../../assets/rol/navegantes/05-ouroboros-calle-de-los-misterios.jpg";

const juegos = await getAllJuegos();
const jugados = await Promise.all(juegos.filter((j) => j.data.jugado.nosotros).map(resuelveJuego));
const nSistemas = (await getSistemasRol()).length;
const nLicencias = (await getAllLicencias()).length;
const modulos = await getAllModulos();
const campanas = await getAllCampanas();
const mesas = await getAllMesas();
const nAutoria = (await getAllAutoria()).length;
const nEditoriales = (await getAllEditoriales()).length;
// Ludoteca: tira de portadas oficiales (las de los juegos que hemos jugado, hasta 3), con el crédito debajo de cada una.
const tira = jugados.filter((f) => f.juego.data.portada).slice(0, 3).map((f) => f.juego);
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const corto = (s: (typeof jugados)[number]["sistema"]) => s?.data.nombreCorto ?? s?.data.name;
---

<Layout
  title="Juegos de rol"
  description="Los juegos de rol que jugamos ahora: con qué reglas, quién los escribió, qué licencia tienen y qué edición jugamos."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/rol")}
      seccion="Rol"
      titulo="Juegos de rol"
      entradilla="Lo que jugamos ahora: con qué reglas, quién lo escribió y qué licencia tiene. Cada dato, con su fuente."
    />

    <div class="tz-puertas">
      <section class="tz-puerta" aria-labelledby="s-ludoteca">
        <div class="tz-puerta-imagen tz-puerta-imagen--tira">
          {tira.map((j) => (
            <figure class="tz-puerta-portada">
              <Picture src={j.data.portada!.archivo} alt={`Portada de ${j.data.portada!.titulo ?? j.data.titulo} (${j.data.portada!.edicion})`} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[200, 400]} sizes="12rem" quality={45} class="tz-portada-img" loading="eager" decoding="async" />
              <figcaption><CreditoPortada juego={j} /></figcaption>
            </figure>
          ))}
        </div>
        <p class="tz-puerta-rotulo">01</p>
        <h2 id="s-ludoteca" class="tz-puerta-titulo">Ludoteca</h2>
        <p class="tz-puerta-texto">Los juegos que jugamos, sus reglas y lo que permite su licencia. Cada dato, con su fuente.</p>
        <ul class="tz-puerta-enlaces" role="list">
          <li><a href="/rol/juegos"><span class="tz-puerta-nombre">Juegos</span><span class="tz-puerta-cifra">{juegos.length}</span><span aria-hidden="true">›</span></a></li>
          <li><a href="/rol/sistemas"><span class="tz-puerta-nombre">Sistemas de reglas</span><span class="tz-puerta-cifra">{nSistemas}</span><span aria-hidden="true">›</span></a></li>
          <li><a href="/rol/licencias"><span class="tz-puerta-nombre">Licencias</span><span class="tz-puerta-cifra">{nLicencias}</span><span aria-hidden="true">›</span></a></li>
          <li><a href="/rol/autoria"><span class="tz-puerta-nombre">Autoría</span><span class="tz-puerta-cifra">{nAutoria}</span><span aria-hidden="true">›</span></a></li>
          <li><a href="/rol/editoriales"><span class="tz-puerta-nombre">Editoriales</span><span class="tz-puerta-cifra">{nEditoriales}</span><span aria-hidden="true">›</span></a></li>
        </ul>
      </section>

      <section class="tz-puerta" aria-labelledby="s-cronicas">
        <figure class="tz-modulo-imagen tz-puerta-figura">
        <div class="tz-puerta-imagen">
          <Picture src={imagenCronicas} alt="Callejón de puestos con un rótulo de tienda con medallón; torres al fondo." formats={["avif", "webp"]} fallbackFormat="jpg" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 36rem, calc(100vw - 2rem)" quality={55} class="tz-puerta-foto" loading="eager" decoding="async" />
        </div>
        <figcaption class="tz-puerta-credito">La Calle de los Misterios, en el Distrito Ouroboros, del módulo «Los Navegantes del Sueño». Ilustración hecha con IA por el autor del módulo; CC0.</figcaption>
        </figure>
        <p class="tz-puerta-rotulo">02</p>
        <h2 id="s-cronicas" class="tz-puerta-titulo">Crónicas</h2>
        <p class="tz-puerta-texto">Lo que pasa alrededor de nuestra mesa: las aventuras que jugamos, contadas, y los módulos que salen de ellas, abiertos para que los juegue cualquiera.</p>
        <ul class="tz-puerta-enlaces" role="list">
          {modulos.map((m) => <li><a href={hrefModulo(m.id)}><span class="tz-puerta-nombre">Módulo «{m.data.titulo}»<span class="tz-puerta-detalle">Para jugarlo en tu mesa · CC0</span></span><span aria-hidden="true">›</span></a></li>)}
          {campanas.map((c) => <li><a href={hrefCampana(c.id)}><span class="tz-puerta-nombre">Campaña «{c.data.titulo}»<span class="tz-puerta-detalle">Cómo la jugamos · desvela el misterio</span></span><span aria-hidden="true">›</span></a></li>)}
          {mesas.map((m) => <li><a href={hrefMesa(m.id)}><span class="tz-puerta-nombre">{m.data.nombre}<span class="tz-puerta-detalle">La mesa</span></span><span aria-hidden="true">›</span></a></li>)}
          <li><a href="/rol/modulos"><span class="tz-puerta-nombre">Todos los módulos</span><span class="tz-puerta-cifra">{modulos.length}</span><span aria-hidden="true">›</span></a></li>
          <li><a href="/rol/campanas"><span class="tz-puerta-nombre">Todas las campañas</span><span class="tz-puerta-cifra">{campanas.length}</span><span aria-hidden="true">›</span></a></li>
        </ul>
      </section>
    </div>

    <section class="tz-seccion" aria-labelledby="s-jugado">
      <Titulo id="s-jugado" numero="03">Lo que hemos jugado</Titulo>
      {jugados.length > 0 ? (
        <>
          <ul class="tz-portadas">
            {jugados.map((f) => (
              <li>
                <a href={`/rol/juegos/${f.juego.id}`}>
                  <PortadaJuego juego={f.juego} sistema={corto(f.sistema)} />
                  <span class="tz-portadas-nota">
                    {f.estado === "en-construccion"
                      ? <Estado estado="parcial" texto={estadoJuego["en-construccion"]} />
                      : f.edicionJugadaTexto ?? <>Edición: <Pendiente /></>}
                  </span>
                </a>
                <CreditoPortada juego={f.juego} />
              </li>
            ))}
          </ul>
          <p style="margin:var(--e-6) 0 0">
            <a class="tz-enlace-bloque" href="/rol/juegos"><span>Ver los {juegos.length} juegos con sus datos</span><span aria-hidden="true">›</span></a>
          </p>
        </>
      ) : (
        <div class="tz-medida"><Pendiente mensaje="Todavía no hay ningún juego registrado." /></div>
      )}
      <p class="tz-ref tz-medida" style="margin:var(--e-4) 0 0">Portadas oficiales, sacadas de la web de cada editorial y reproducidas sin ánimo de lucro. Debajo de cada una, la edición que jugamos y de dónde sale la imagen. Si la editorial no publica la portada, va un hueco con el título.</p>
    </section>

    <section class="tz-seccion" aria-labelledby="s-jornadas">
      <Titulo id="s-jornadas" numero="04">Y en las Jornadas</Titulo>
      <p class="tz-medida" style="margin:0">
        Lo que se jugó en las Jornadas Talazbrágoles, en los años noventa, es otra cosa: está en el Archivo.
      </p>
      <div class="tz-acciones" style="margin-top:var(--e-5)">
        <a class="tz-boton" href="/sistemas">Sistemas de las Jornadas</a>
      </div>
    </section>
  </div>
</Layout>
