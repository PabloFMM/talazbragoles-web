---
/** /rol/campanas/: campañas jugadas por nuestras mesas (Rol 7/8, 2026-11-24). */
import { getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Encabezado from "../../../components/sistema/Encabezado.astro";
import Titulo from "../../../components/sistema/Titulo.astro";
import Pendiente from "../../../components/sistema/Pendiente.astro";
import { getAllCampanas } from "../../../lib/collections";
import { estadoCampana } from "../../../lib/formato";
import { numeroSeccion } from "../../../lib/nav";
import { hrefCampana } from "../../../lib/rol-rutas";

const campanas = await Promise.all(
  (await getAllCampanas()).map(async (c) => ({ campana: c, juego: await getEntry(c.data.juego), mesa: await getEntry(c.data.mesa) }))
);
---

<Layout title="Campañas" description="Las campañas que han jugado nuestras mesas: reparto, jornadas y lo que la mesa aportó al juego.">
  <div class="tz-pagina">
    <Encabezado
      migas={[{ texto: "Rol", href: "/rol" }, { texto: "Campañas" }]}
      numero={numeroSeccion("/rol")}
      seccion="Rol"
      titulo="Campañas"
      entradilla="Lo que han jugado nuestras mesas: reparto de personajes, jornada a jornada y la verdad que construyó cada mesa. Desvelan los módulos en que se basan."
    />
    <section class="tz-seccion" aria-labelledby="s-campanas">
      <Titulo id="s-campanas" numero="01">Campañas publicadas</Titulo>
      {campanas.length > 0 ? (
        <ul class="tz-lista-enlaces tz-lista-enlaces--una tz-medida">
          {campanas.map(({ campana, juego, mesa }) => (
            <li>
              <a href={hrefCampana(campana.id)}>
                <span class="tz-lista-enlaces-nombre">{campana.data.titulo}</span>
                <span class="tz-lista-enlaces-detalle">{juego?.data.titulo} · {mesa?.data.nombre} · {estadoCampana[campana.data.estado]}</span>
                <span class="tz-lista-enlaces-flecha" aria-hidden="true">›</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="tz-medida"><Pendiente mensaje="Todavía no hay ninguna campaña publicada." /></div>
      )}
    </section>
    <div class="tz-acciones" style="margin-bottom:var(--aire)">
      <a class="tz-boton" href="/rol"><span aria-hidden="true">‹</span> Volver a Rol</a>
    </div>
  </div>
</Layout>
