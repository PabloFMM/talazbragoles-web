---
/**
 * /rol/juegos/: catálogo de los juegos de rol que jugamos (colección «juegos»).
 * Una fila por juego: portada tipográfica, autoría, sistema, licencia, edición
 * que jugamos y si hay descarga oficial. Sin JavaScript. Los filtros (páginas ya
 * filtradas por licencia, sistema, género…) llegan con Rol 3/4.
 */
import Layout from "../../../layouts/Layout.astro";
import Encabezado from "../../../components/sistema/Encabezado.astro";
import Titulo from "../../../components/sistema/Titulo.astro";
import Datos from "../../../components/sistema/Datos.astro";
import Estado from "../../../components/sistema/Estado.astro";
import PortadaTipografica from "../../../components/sistema/PortadaTipografica.astro";
import { getAllJuegos, resuelveJuego } from "../../../lib/collections";
import { estadoJuego, listaY } from "../../../lib/formato";
import { numeroSeccion } from "../../../lib/nav";

const fichas = await Promise.all((await getAllJuegos()).map(resuelveJuego));
const corto = (s: (typeof fichas)[number]["sistema"]) => s?.data.nombreCorto ?? s?.data.name;
const licencia = (f: (typeof fichas)[number]) => {
  const juego = [...new Set(f.licenciasJuego.map((l) => l.licencia.data.nombreCorto))];
  const partes = [juego.length ? `${listaY(juego)}` : undefined, f.licenciaSistema ? `sistema: ${f.licenciaSistema.data.nombreCorto}` : undefined];
  return partes.filter(Boolean).join("; ") || undefined;
};
---

<Layout
  title="Catálogo de juegos de rol"
  description={`Los ${fichas.length} juegos de rol que jugamos: sistema, licencia, autoría, edición que jugamos y descarga oficial cuando la hay.`}
>
  <div class="tz-pagina">
    <Encabezado
      migas={[{ texto: "Rol", href: "/rol" }, { texto: "Juegos" }]}
      numero={numeroSeccion("/rol")}
      seccion="Rol"
      titulo="Juegos"
      entradilla="Los juegos de rol que jugamos: con qué reglas, quién los escribió, qué licencia tienen y qué edición jugamos."
    >
      <p class="tz-recuento">{fichas.length} juegos, por orden alfabético.</p>
    </Encabezado>

    <section class="tz-seccion" aria-labelledby="s-juegos">
      <Titulo id="s-juegos" numero="01">Todos los juegos</Titulo>
      <div class="tz-nota tz-medida" style="margin-bottom:var(--e-6)">
        <p>La licencia del juego y la de su sistema pueden ser distintas: el texto de un juego puede estar cerrado aunque sus reglas sean libres. Un dato sin fuente aparece «pendiente».</p>
      </div>
      <ol class="tz-catalogo">
        {fichas.map((f) => {
          const d = f.juego.data;
          return (
            <li class="tz-catalogo-fila">
              <PortadaTipografica titulo={d.titulo} sistema={corto(f.sistema)} decorativa />
              <div>
                <h3 class="tz-registro-titulo"><a href={`/rol/juegos/${f.juego.id}`}>{d.titulo}</a></h3>
                {f.estado === "en-construccion" && (
                  <p class="tz-recuento" style="margin-top:var(--e-2)"><Estado estado="parcial" texto={estadoJuego["en-construccion"]} /></p>
                )}
                <Datos
                  class="tz-datos--ancho"
                  datos={[
                    { etiqueta: "Autoría", valor: f.autoria.length ? listaY(f.autoria.map((a) => a.data.nombre)) : undefined },
                    { etiqueta: "Sistema", valor: corto(f.sistema) },
                    { etiqueta: "Licencia", valor: licencia(f) },
                    { etiqueta: "Edición que jugamos", valor: f.edicionJugadaTexto },
                    { etiqueta: "Descarga oficial", valor: f.descargable ? "Sí" : "No hay ninguna registrada" },
                  ]}
                />
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <div class="tz-acciones" style="margin-bottom:var(--aire)">
      <a class="tz-boton" href="/rol"><span aria-hidden="true">‹</span> Portada de Rol</a>
    </div>
  </div>
</Layout>
