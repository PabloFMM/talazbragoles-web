---
import { render } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import MmoStyles from "../../../../components/mmo/MmoStyles.astro";
import { mainNav } from "../../../../lib/nav";
import { getAllGuides } from "../../../../lib/collections";

export async function getStaticPaths() {
  const guides = await getAllGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const secciones = headings.filter((h) => h.depth === 2);
---

<Layout
  title={`${guide.data.profesion} · Guía de WoW Forever · TALAZBRÁGOLES`}
  description={`Guía de ${guide.data.profesion} en World of Warcraft: Forever: cómo empezar, rangos, ruta para subir y fuentes.`}
  canonicalPath={`/mmo/wow-forever/guias/${guide.id}`}
  nav={mainNav}
>
  <MmoStyles />
  <div class="mmo max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-14">
    <ul class="mmo-nav" aria-label="Navegación de la sección">
      <li><a class="mmo-btn" href="/mmo/wow-forever/guias">← Todas las guías</a></li>
      <li><a class="mmo-btn" href="/mmo/wow-forever/asesor/">Abrir el asesor</a></li>
    </ul>

    <p class="mmo-fuente">Tipo: {guide.data.tipo} · Comprobado: {guide.data.comprobado}</p>

    <div class="mmo-aviso">
      <p>
        <strong>Cómo leer esta guía.</strong> Está redactada el {guide.data.comprobado} a partir de páginas públicas,
        no de pruebas en el juego. Cada dato dice de qué sitio sale. Cuando dos sitios no coinciden, no se elige:
        está apuntado en «Dudas y contradicciones». Lo que no se ha podido confirmar está en «Pendiente».
      </p>
    </div>

    <nav aria-label="Índice de la guía">
      <p><strong>En esta guía:</strong></p>
      <ul>
        {secciones.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ul>
    </nav>

    <article>
      <Content />
    </article>
  </div>
</Layout>
