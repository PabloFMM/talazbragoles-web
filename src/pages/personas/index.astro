---
/**
 * /personas/: fichas de la colección «people» (sin borradores).
 * Hoy está vacía: estado «pendiente» y los testimonios anónimos que sí hay.
 */
import Layout from "../../layouts/Layout.astro";
import Encabezado from "../../components/sistema/Encabezado.astro";
import Titulo from "../../components/sistema/Titulo.astro";
import Ficha from "../../components/sistema/Ficha.astro";
import Pendiente from "../../components/sistema/Pendiente.astro";
import { getAllPeople, getAllSources } from "../../lib/collections";
import { anclaFuente, dosCifras, papelPersona } from "../../lib/formato";
import { numeroSeccion } from "../../lib/nav";

const personas = await getAllPeople();
const testimonios = (await getAllSources()).filter(
  (s) => s.data.type === "testimonio" && s.data.tags.includes("menciona Talazbrágoles"),
);
---

<Layout
  title="Personas"
  description="Personas de las Jornadas Talazbrágoles: organización, dirección de partidas y testimonios. Solo nombres con fuente."
>
  <div class="tz-pagina">
    <Encabezado
      numero={numeroSeccion("/personas")}
      seccion="Archivo"
      titulo="Personas"
      entradilla="Quién organizó, dirigió partidas o jugó en las Jornadas. Solo aparece un nombre si una fuente lo da."
    />

    <section class="tz-seccion" aria-labelledby="s-fichas">
      <Titulo id="s-fichas" numero="01">Fichas</Titulo>
      {personas.length > 0 ? (
        <div class="tz-fichas">
          {personas.map((p, i) => (
            <Ficha
              numero={dosCifras(i + 1)}
              titulo={p.data.name}
              datos={[
                { etiqueta: "Papel", valor: p.data.roles.map((r) => papelPersona[r]).join(", ") },
                { etiqueta: "Ediciones", valor: p.data.editionIds.length || undefined },
                { etiqueta: "Fuentes", valor: p.data.sourceIds.length || undefined },
              ]}
            />
          ))}
        </div>
      ) : (
        <div class="tz-medida">
          <Pendiente
            mensaje="Todavía no hay ninguna persona con ficha: las fuentes reunidas no nombran a quienes organizaron las Jornadas ni a quienes dirigieron sus partidas."
            pide="Ayudarían programas con nombres, créditos de La Runa o testimonios de quienes estuvieron."
          />
        </div>
      )}
    </section>

    {testimonios.length > 0 && (
      <section class="tz-seccion" aria-labelledby="s-testimonios">
        <Titulo id="s-testimonios" numero="02">Testimonios recogidos</Titulo>
        <p class="tz-medida" style="margin:0 0 var(--e-5)">Personas que cuentan que estuvieron. Sin ficha propia: el archivo no recoge sus nombres.</p>
        <ol class="tz-lista-numerada tz-medida">
          {testimonios.map((s) => (
            <li><span>{s.data.asserts} <span class="tz-ref">(<a href={anclaFuente(s.id)}>{s.data.title}</a>)</span></span></li>
          ))}
        </ol>
      </section>
    )}
  </div>
</Layout>
