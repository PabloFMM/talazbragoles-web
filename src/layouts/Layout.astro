---
/**
 * Layout compartido para toda la web (sistema «Papel y tinta»).
 * Cabecera con el logotipo tipográfico, índice sin JS (<details> en móvil,
 * fila en escritorio) y pie. Tokens y componentes: src/styles/sistema.css.
 * Documentación: proyecto/docs/diseno.md · Muestrario: /diseno/
 *
 * Nota de rigor: esta web es un archivo. Lo no verificable se marca «pendiente».
 */

import "../styles/global.css";
import Logo from "../components/sistema/Logo.astro";
import { mainNav } from "../lib/nav";
import { dosCifras } from "../lib/formato";

interface Props {
  /** Título de la página; se le añade « · Talazbrágoles» si no lleva ya la marca. */
  title: string;
  description: string;
  /** Ruta canónica. Por defecto, la de la página sin barra final (/fuentes/ → /fuentes). */
  canonicalPath?: string;
  /** Páginas internas (p. ej. /diseno/): no indexar. */
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;

const MARCA = "Talazbrágoles";
const siteUrl = Astro.site ?? new URL("https://www.talazbragoles.com");
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(canonicalPath ?? ruta, siteUrl).toString();

// Sin la marca repetida: «Talazbrágoles — 5ª edición» no lleva « · Talazbrágoles» (sin mirar mayúsculas ni tildes).
const llano = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
const tituloCompleto = llano(title).includes(llano(MARCA)) ? title : `${title} · ${MARCA}`;
// Imagen para redes: generada con proyecto/tools/og-imagen.mjs (1200 × 630, solo tipografía).
const ogImage = new URL("/og.png", siteUrl).toString();
const ogImageAlt = "Talazbrágoles · Archivo de las Jornadas, en tinta negra sobre papel claro.";

// Entrada activa del índice (sin JS: se calcula en el build).
const esActual = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? ruta === "/" : ruta === h || ruta.startsWith(h + "/");
};
const indice = mainNav.map((item, i) => ({
  ...item,
  n: dosCifras(i + 1),
  actual: esActual(item.href),
}));
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{tituloCompleto}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Talazbrágoles,Talazbragoles,jornadas,rol,simulación,Las Rozas,Majadahonda,Las Matas,archivo,nostalgia,90s" />
    <meta name="theme-color" content="#f4f0e6" />

    <link rel="preload" href="/fonts/archivo-wdth-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-opsz-wght.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={MARCA} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body>
    <a href="#contenido" class="tz-saltar">Saltar al contenido</a>

    <header class="tz-cabecera">
      <div class="tz-pagina">
        <div class="tz-cabecera-fila">
          <Logo />
        </div>

        <nav class="tz-nav" aria-label="Secciones">
          <details class="tz-nav-plegable">
            <summary>Índice</summary>
            <ul>
              {indice.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.actual ? "page" : undefined}>
                    <span class="tz-num" aria-hidden="true">{item.n}</span>
                    <span class="tz-nav-texto">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>

          <div class="tz-nav-fila">
            <ul>
              {indice.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.actual ? "page" : undefined}>
                    <span class="tz-num" aria-hidden="true">{item.n}</span>
                    <span class="tz-nav-texto">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="tz-pie">
      <div class="tz-pagina">
        <div class="tz-pie-cols">
          <section aria-labelledby="pie-metodo">
            <h2 id="pie-metodo">El método</h2>
            <p>Esto es memoria, pero también método: si no hay fuente, lo decimos. Si falta un dato, lo pedimos.</p>
          </section>

          <nav aria-labelledby="pie-indice">
            <h2 id="pie-indice">Índice</h2>
            <ul class="tz-pie-indice">
              {mainNav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>

          <section aria-labelledby="pie-tipos">
            <h2 id="pie-tipos">Tipografía</h2>
            <p>
              Archivo y Source Serif 4, tipos de licencia libre
              (<a href="/fonts/OFL-Archivo.txt">SIL OFL 1.1</a>).
            </p>
          </section>
        </div>

        <div class="tz-pie-final">
          <span>Talazbrágoles · Archivo de las Jornadas</span>
          <span>Hecho con dados y nostalgia</span>
        </div>
      </div>
    </footer>
  </body>
</html>
