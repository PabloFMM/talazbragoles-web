---
/**
 * Layout compartido para toda la web (sistema «Papel y tinta»).
 * Cabecera con el logotipo tipográfico, índice sin JS (<details> en móvil,
 * fila en escritorio) y pie. Tokens y componentes: src/styles/sistema.css.
 * Documentación: proyecto/docs/diseno.md · Muestrario: /diseno/
 *
 * Nota de rigor: esta web es un archivo. Lo no verificable se marca «pendiente».
 */

import "../styles/global.css";
import Logo from "../components/sistema/Logo.astro";
import { mainNav, type NavItem } from "../lib/nav";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  nav?: NavItem[];
  /** Páginas internas (p. ej. /diseno/): no indexar. */
  noindex?: boolean;
}

const {
  title = "TALAZBRÁGOLES",
  description = "Web oficial del legado de las Talazbrágoles: un archivo vivo de recuerdos, fuentes y documentación rolera.",
  canonicalPath = "/",
  nav = mainNav,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? new URL(Astro.site) : new URL("https://www.talazbragoles.com");
const canonical = new URL(canonicalPath, siteUrl).toString();

const ogTitle = title.includes("TALAZBRÁGOLES") ? title : `${title} · TALAZBRÁGOLES`;
const ogImage = new URL("/og.png", siteUrl).toString(); // TODO: añadir imagen real en /public/og.png

// Entrada activa del índice (sin JS: se calcula en el build).
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const esActual = (href: string) => {
  if (href.includes("#")) return false;
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? ruta === "/" : ruta === h || ruta.startsWith(h + "/");
};
const indice = nav.map((item, i) => ({
  ...item,
  n: String(i + 1).padStart(2, "0"),
  actual: esActual(item.href),
}));
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{ogTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Talazbrágoles,Talazbragoles,jornadas,rol,simulación,Las Rozas,Majadahonda,Las Matas,archivo,nostalgia,90s" />
    <meta name="theme-color" content="#f4f0e6" />

    <link rel="preload" href="/fonts/archivo-wdth-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-opsz-wght.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a href="#contenido" class="tz-saltar">Saltar al contenido</a>

    <header class="tz-cabecera">
      <div class="tz-pagina">
        <div class="tz-cabecera-fila">
          <Logo />
        </div>

        <nav class="tz-nav" aria-label="Secciones">
          <details class="tz-nav-plegable">
            <summary>Índice</summary>
            <ul>
              {indice.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.actual ? "page" : undefined}>
                    <span class="tz-num" aria-hidden="true">{item.n}</span>
                    <span class="tz-nav-texto">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>

          <div class="tz-nav-fila">
            <ul>
              {indice.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.actual ? "page" : undefined}>
                    <span class="tz-num" aria-hidden="true">{item.n}</span>
                    <span class="tz-nav-texto">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="tz-pie">
      <div class="tz-pagina">
        <div class="tz-pie-cols">
          <section aria-labelledby="pie-metodo">
            <h2 id="pie-metodo">El método</h2>
            <p>Esto es memoria, pero también método: si no hay fuente, lo decimos. Si falta un dato, lo pedimos.</p>
            <p>Si tienes material (programas, carteles, fotos, recortes), aquí lo cuidamos.</p>
          </section>

          <nav aria-labelledby="pie-indice">
            <h2 id="pie-indice">Índice</h2>
            <ul class="tz-pie-indice">
              {mainNav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>

          <section aria-labelledby="pie-tipos">
            <h2 id="pie-tipos">Tipografía</h2>
            <p>
              Archivo y Source Serif 4, tipos de licencia libre
              (<a href="/fonts/OFL-Archivo.txt">SIL OFL 1.1</a>).
            </p>
          </section>
        </div>

        <div class="tz-pie-final">
          <span>Talazbrágoles · Archivo de las Jornadas</span>
          <span>Hecho con dados y nostalgia</span>
        </div>
      </div>
    </footer>
  </body>
</html>
