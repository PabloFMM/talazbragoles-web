---
/**
 * Nota de fuente numerada: qué es, qué dice y con qué reservas (lo que NO dice).
 * Recibe una entrada de la colección «sources». Usar dentro de <ol class="tz-fuentes">.
 */
import type { CollectionEntry } from "astro:content";
import { dosCifras, tipoFuente } from "../../lib/formato";

interface Props {
  fuente: CollectionEntry<"sources">;
  n: number;
  /** Pone id = id de la fuente, para enlazarla desde otras páginas (solo en /fuentes/). */
  ancla?: boolean;
}
const { fuente, n, ancla = false } = Astro.props;
const { title, url, type, date, accessDate, asserts, caveat, broken } = fuente.data;
const meta = [tipoFuente[type], date, accessDate && `consultada el ${accessDate}`].filter(Boolean).join(" · ");
---
<li class="tz-fuente" id={ancla ? fuente.id : undefined}>
  <span class="tz-fuente-n tz-num" aria-hidden="true">{dosCifras(n)}</span>
  <div>
    <p class="tz-fuente-titulo">
      {broken ? <><span class="tz-fuente-caido">{title}</span> (enlace caído)</> : <a href={url} rel="noreferrer">{title}</a>}
    </p>
    {meta && <p class="tz-fuente-meta">{meta}</p>}
    {asserts && <p><span class="tz-fuente-etiqueta">Dice:</span> {asserts}</p>}
    {caveat && <p class="tz-fuente-reserva"><span class="tz-fuente-etiqueta">Reservas:</span> {caveat}</p>}
  </div>
</li>
