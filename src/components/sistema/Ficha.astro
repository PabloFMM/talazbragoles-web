---
/**
 * Ficha de archivo: cabeza (número + estado), título, datos (dl) y pie con enlace.
 * Los datos sin valor se muestran como «pendiente», nunca se omiten en silencio.
 */
import Estado from "./Estado.astro";
import Pendiente from "./Pendiente.astro";

interface Dato { etiqueta: string; valor?: string | number | null }
interface Props {
  titulo: string;
  numero?: string;
  estado?: "documentada" | "parcial" | "pendiente";
  datos?: Dato[];
  href?: string;
  enlace?: string;
  nivel?: 2 | 3;
}
const { titulo, numero, estado, datos = [], href, enlace = "Ver ficha", nivel = 3 } = Astro.props;
const Tag = nivel === 2 ? "h2" : "h3";
const vacio = (v: Dato["valor"]) => v === undefined || v === null || String(v).trim() === "";
---
<article class="tz-ficha">
  {(numero || estado) && (
    <div class="tz-ficha-cabeza">
      {numero ? <span class="tz-num">{numero}</span> : <span />}
      {estado && <Estado estado={estado} />}
    </div>
  )}
  <div class="tz-ficha-cuerpo">
    <Tag class="tz-ficha-titulo">{href ? <a href={href}>{titulo}</a> : titulo}</Tag>
    {datos.length > 0 && (
      <dl class="tz-datos">
        {datos.map((d) => (
          <div>
            <dt>{d.etiqueta}</dt>
            <dd>{vacio(d.valor) ? <Pendiente /> : d.valor}</dd>
          </div>
        ))}
      </dl>
    )}
    <slot />
  </div>
  {href && (
    <div class="tz-ficha-pie">
      <a href={href} aria-label={`${enlace}: ${titulo}`}><span>{enlace}</span><span aria-hidden="true">›</span></a>
    </div>
  )}
</article>
