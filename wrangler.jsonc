// Cloudflare Workers (solo archivos estáticos): sirve dist/ tal cual.
// "name" debe coincidir con el nombre del proyecto en el panel de Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talazbragoles-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
